# Equatorial Guinea Addressing Platform — production template
# Use only after formal production readiness approval, real operator accounts,
# monitoring, backup/restore proof, and institutional publication authority are in place.
APP_ENV=production
NEXT_PUBLIC_DEPLOYMENT_LABEL="OFFICIAL PRODUCTION"
PROJECT_NAME=eg-addressing
COMPOSE_PROJECT_NAME=eg_addressing_prod
TZ=Africa/Malabo
LOG_LEVEL=INFO

ADMIN_PORT=3100
API_PORT=8100
POSTGRES_PORT=5434
REDIS_PORT=6384
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

POSTGRES_DB=addressing
POSTGRES_USER=addressing_app
POSTGRES_PASSWORD=replace_with_production_database_password
DATABASE_URL=postgresql+psycopg://addressing_app:replace_with_production_database_password@postgres:5432/addressing

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=https://object-storage.example.gov.gq
S3_REGION=africa-malabo-1
S3_BUCKET=addressing-production
S3_ACCESS_KEY=replace_with_scoped_production_access_key
S3_SECRET_KEY=replace_with_scoped_production_secret_key

JWT_SECRET=replace_with_production_jwt_secret
SESSION_SECRET=replace_with_production_session_secret
SESSION_TTL_HOURS=8
SESSION_COOKIE_MODE=secure-http-only-cookie
SESSION_COOKIE_SECURE=true
ALLOW_DEFAULT_DEMO_PASSWORDS=false
# Development fixtures must remain disabled in production.
EG_ALLOW_DEV_FIXTURES=NO
PUBLICATION_RELEASE_ENABLED=false
NEXT_PUBLIC_PUBLICATION_RELEASE_ENABLED=false
SMOKE_ADMIN_USERNAME=replace_with_smoke_operator_username
# SMOKE_ADMIN_PASSWORD=store_outside_git

ADMIN_BASE_URL=https://addressing.example.gov.gq
API_BASE_URL=https://addressing.example.gov.gq/api
NEXT_PUBLIC_API_BASE_URL=
INTERNAL_API_BASE_URL=http://api:8100

PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_MAX_REQUESTS=30
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
