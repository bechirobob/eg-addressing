# Equatorial Guinea Addressing Platform — local development example
# Copy to ../.env for private local work. Do not use this file for ministry review
# or production deployment.
APP_ENV=local
NEXT_PUBLIC_DEPLOYMENT_LABEL="Local development"
PROJECT_NAME=eg-addressing
COMPOSE_PROJECT_NAME=eg_addressing
TZ=Africa/Malabo
LOG_LEVEL=INFO

# App ports
ADMIN_PORT=3100
API_PORT=8100
POSTGRES_PORT=5434
REDIS_PORT=6384
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# Database
POSTGRES_DB=addressing
POSTGRES_USER=addressing
POSTGRES_PASSWORD=replace_with_local_database_password
DATABASE_URL=postgresql+psycopg://addressing:replace_with_local_database_password@postgres:5432/addressing

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-1
S3_BUCKET=addressing-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth
JWT_SECRET=change_local_jwt_secret
SESSION_SECRET=change_local_session_secret
SESSION_TTL_HOURS=12
SESSION_COOKIE_MODE=secure-http-only-cookie
SESSION_COOKIE_SECURE=false
ALLOW_DEFAULT_DEMO_PASSWORDS=false
PUBLICATION_RELEASE_ENABLED=false
NEXT_PUBLIC_PUBLICATION_RELEASE_ENABLED=false
SMOKE_ADMIN_USERNAME=admin
# SMOKE_ADMIN_PASSWORD=change_me_outside_git

# App URLs
ADMIN_BASE_URL=http://localhost:3100
API_BASE_URL=http://localhost:8100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
INTERNAL_API_BASE_URL=http://api:8100

# Public endpoint protection
PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_MAX_REQUESTS=30
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
