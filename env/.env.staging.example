# Equatorial Guinea Addressing Platform — controlled staging example
# Use for ministry/demo review only. Public pages must clearly show controlled
# staging / not official production status.
APP_ENV=staging
NEXT_PUBLIC_DEPLOYMENT_LABEL="STAGING / NOT OFFICIAL PRODUCTION RECORD"
PROJECT_NAME=eg-addressing
COMPOSE_PROJECT_NAME=eg_addressing
TZ=Africa/Malabo
LOG_LEVEL=INFO

ADMIN_PORT=3100
API_PORT=8100
POSTGRES_PORT=5434
REDIS_PORT=6384
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

POSTGRES_DB=addressing
POSTGRES_USER=addressing
POSTGRES_PASSWORD=replace_with_staging_database_password
DATABASE_URL=postgresql+psycopg://addressing:replace_with_staging_database_password@postgres:5432/addressing

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-1
S3_BUCKET=addressing-staging
S3_ACCESS_KEY=replace_with_staging_access_key
S3_SECRET_KEY=replace_with_staging_secret_key

JWT_SECRET=replace_with_staging_jwt_secret
SESSION_SECRET=replace_with_staging_session_secret
SESSION_TTL_HOURS=12
SESSION_COOKIE_MODE=secure-http-only-cookie
SESSION_COOKIE_SECURE=true
ALLOW_DEFAULT_DEMO_PASSWORDS=false
SMOKE_ADMIN_USERNAME=admin
# SMOKE_ADMIN_PASSWORD=store_outside_git

ADMIN_BASE_URL=https://eg-addressing.example.gov.gq
API_BASE_URL=https://eg-addressing.example.gov.gq/api
NEXT_PUBLIC_API_BASE_URL=
INTERNAL_API_BASE_URL=http://api:8100

PUBLIC_RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_MAX_REQUESTS=30
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
