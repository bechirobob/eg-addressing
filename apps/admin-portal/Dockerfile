FROM node:20-alpine

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY apps/admin-portal/package.json ./package.json
RUN npm install

COPY apps/admin-portal/ ./
ARG NEXT_PUBLIC_API_BASE_URL=""
ARG NEXT_PUBLIC_APP_ENV="staging"
ARG NEXT_PUBLIC_DEPLOYMENT_LABEL="STAGING / NOT OFFICIAL PRODUCTION RECORD"
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_DEPLOYMENT_LABEL=$NEXT_PUBLIC_DEPLOYMENT_LABEL
RUN npm run build

EXPOSE 3100

CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3100"]
